{
  "name": "@aave-dao/rpc-env",
  "version": "1.1.0",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "echo 'No tests yet'",
    "format": "biome check --write",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "author": "Aave",
  "devDependencies": {
    "@aave-dao/toolbox": "^0.6.1",
    "@actions/core": "^3.0.1",
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "lefthook": "^2.1.12",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "tsup": {
    "entry": [
      "src/action.ts"
    ],
    "splitting": false,
    "sourcemap": false,
    "clean": true,
    "dts": true,
    "treeshake": true,
    "format": [
      "esm",
      "cjs"
    ]
  }
